# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
build/
dist/
env/
venv/
.venv/

# OS
.DS_Store

# IDE
.vscode/
.idea/

# Nexus runtime data and credentials
# Everything under data/ is local state or imported course material. Keep only
# the redacted feed template in source control.
data/**
!data/feeds.example.json

# Root-level runtime/cache JSON
tasks.json
*.local.json

# The private-beta quickstart creates this local runtime at the repository root.
nexus-data/
nexus-practice/

# OAuth / API credentials (root or nested)
*client_secret*.json
*credentials*.json
*token*.json

# API key files
*API_KEY*.json
*api_key*.json

# Environment variables
.env
source .env

# Streamlit secrets (contains API keys)
.streamlit/secrets.toml

# Agent tooling runtime state (project agent definitions are source-controlled)
.codex/*
!.codex/agents/
.codex/agents/**
!.codex/agents/*.toml

# Runtime data artifacts
data/conversations/
data/.nexus-maintenance.lock
data/debug/
data/backups/
