# Nexus Backup — weekly at 03:00 on Sunday
# Edit PROJECT_DIR to point at your checkout.

PROJECT_DIR=/path/to/Nexus
NEXUS_DATA_DIR=/path/to/nexus-data
0 3 * * 0 cd $PROJECT_DIR && PYTHONPATH=src python -m nexus.cli.db_backup --sqlite-path $NEXUS_DATA_DIR/nexus.db --db-dir $NEXUS_DATA_DIR/chroma --output $NEXUS_DATA_DIR/backups/nexus-{timestamp}.zip >> $NEXUS_DATA_DIR/backup_cron.log 2>&1
