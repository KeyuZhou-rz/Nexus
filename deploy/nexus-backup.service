[Unit]
Description=Nexus Database & Chroma Backup
After=nexus-pipeline.service

[Service]
Type=oneshot
WorkingDirectory=/path/to/Nexus
Environment=PYTHONPATH=src
Environment=NEXUS_DATA_DIR=/var/lib/nexus
ExecStart=python -m nexus.cli.db_backup --sqlite-path /var/lib/nexus/nexus.db --db-dir /var/lib/nexus/chroma --output /var/lib/nexus/backups/nexus-{timestamp}.zip
StandardOutput=append:/var/log/nexus/backup.log
StandardError=append:/var/log/nexus/backup.log
User=nexus
