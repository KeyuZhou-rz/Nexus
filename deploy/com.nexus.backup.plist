<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE plist PUBLIC '-//Apple//DTD PLIST 1.0//EN' 'http://www.apple.com/DTDs/PropertyList-1.0.dtd'>
<plist version='1.0'>
<dict>
  <key>Label</key>
  <string>com.nexus.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/you/Library/Application Support/Nexus/venv/bin/python</string>
    <string>-m</string>
    <string>nexus.cli.db_backup</string>
    <string>--sqlite-path</string>
    <string>/Users/you/Library/Application Support/Nexus/nexus.db</string>
    <string>--db-dir</string>
    <string>/Users/you/Library/Application Support/Nexus/chroma</string>
    <string>--output</string>
    <string>/Users/you/Library/Application Support/Nexus/backups/nexus-{timestamp}.zip</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/you/Library/Application Support/Nexus</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NEXUS_DATA_DIR</key>
    <string>/Users/you/Library/Application Support/Nexus</string>
  </dict>
  <key>Umask</key>
  <integer>63</integer>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/you/Library/Logs/Nexus/backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/you/Library/Logs/Nexus/backup.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
