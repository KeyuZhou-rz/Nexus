# Nexus Sync — daily at 06:00
# Runs the single-flight headless sync; browser archive sync is opt-in.
# Edit PROJECT_DIR to point at your checkout.

PROJECT_DIR=/path/to/Nexus
NEXUS_DATA_DIR=/path/to/nexus-data
0 6 * * * cd $PROJECT_DIR && PYTHONPATH=src python -m nexus.cli.main sync --data-dir $NEXUS_DATA_DIR >> $NEXUS_DATA_DIR/sync_cron.log 2>&1
