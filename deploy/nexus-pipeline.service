[Unit]
Description=Nexus Single-Flight Sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/path/to/Nexus
Environment=PYTHONPATH=src
ExecStart=python -m nexus.cli.main sync
StandardOutput=append:/path/to/Nexus/data/pipeline.log
StandardError=append:/path/to/Nexus/data/pipeline.log
User=nexus
