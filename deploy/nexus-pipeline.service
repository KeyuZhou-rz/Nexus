[Unit]
Description=Nexus Single-Flight Sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/path/to/Nexus
Environment=PYTHONPATH=src
Environment=NEXUS_DATA_DIR=/var/lib/nexus
ExecStart=python -m nexus.cli.main sync --data-dir /var/lib/nexus
StandardOutput=append:/var/log/nexus/sync.log
StandardError=append:/var/log/nexus/sync.log
User=nexus
