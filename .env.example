# ─── Nexus Configuration (.env.example) ──────────────────────────────────────
# Copy this file to .env and fill in the values you need.
# All variables are optional — Nexus starts with a functional offline core.

# ─── LLM (optional — required for AI-powered QA, briefing, concept extraction)
# Backend: any OpenAI-compatible API (Qwen DashScope, OpenAI, DeepSeek, etc.)
# Install: pip install nexus-dashboard[llm]
# See docs/LLM_SETUP.md for provider-specific instructions
NEXUS_LLM_ENABLED="0"
NEXUS_LLM_BASE_URL="https://api.deepseek.com"
NEXUS_LLM_MODEL="deepseek-chat"
NEXUS_LLM_API_KEY=""
NEXUS_LLM_JSON_OUTPUT="1"
# Optional: request timeout in seconds
NEXUS_LLM_TIMEOUT="20"

# ─── Google Calendar & Gmail (optional)
# Install: pip install nexus-dashboard[google]
# Requires OAuth 2.0 client secret JSON from Google Cloud Console.
# First run will open a browser for OAuth consent.
NEXUS_GOOGLE_CREDENTIALS="data/google_client_secret.json"
NEXUS_GOOGLE_TOKEN="data/google_token.json"
# Sync interval in minutes (0 = disabled)
NEXUS_GCAL_SYNC_MINUTES="15"

# ─── Brightspace Archive Sync (optional — Playwright browser scraper)
# Install: pip install nexus-dashboard[archive]
# After install, run: playwright install chromium
# Login mode: "manual" (you handle Duo MFA in headed browser)
#             "auto"   (credentials only, no MFA expected)
#             "hybrid" (auto login, fall back to manual on MFA)
NEXUS_BRIGHTSPACE_URL="https://brightspace.nyu.edu"
NEXUS_BRIGHTSPACE_USERNAME="your_netid"
NEXUS_BRIGHTSPACE_PASSWORD="your_password"
NEXUS_BRIGHTSPACE_LOGIN_MODE="manual"
# Archive directory (default: data/archives)
# NEXUS_ARCHIVE_DIR="data/archives"
# Debug mode (0=off, 1=on; default: 1)
# NEXUS_ARCHIVE_DEBUG="1"
# Course discovery timeout in ms (default: 25000)
# NEXUS_ARCHIVE_COURSE_DISCOVERY_TIMEOUT="25000"
# Auto-ingest scraped files into knowledge DB (0=off, 1=on; default: 1)
# NEXUS_ARCHIVE_POST_INGEST="1"

# ─── Canvas LMS (optional)
# REST API with Bearer token authentication.
# Install: core dependencies are sufficient (uses requests).
NEXUS_CANVAS_URL="https://your-school.instructure.com"
NEXUS_CANVAS_TOKEN="your_canvas_api_token"

# ─── PDF Knowledge Ingest (optional)
# Install: pip install nexus-dashboard[pdf]
# Provides pypdf + pymupdf4llm for PDF text extraction.
# If not installed, Markdown/text ingest still works.

# ─── ChromaDB Vector Store
# Installed with core. Version pinned via pyproject.toml.
# Embedding model: all-MiniLM-L6-v2 (sentence-transformers, auto-downloaded).
# Data directory: data/chroma/

# ─── Data Directory (optional — override default)
# NEXUS_DATA_DIR="data"

# ─── UI Display Name (optional)
# NEXUS_DISPLAY_NAME="Your Name"
